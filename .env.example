AIRFLOW_IMAGE_NAME=masar-airflow:3.3.1
AIRFLOW_UID=50000
POSTGRES_USER=masar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# Dashboard data source: bigquery | local | snapshot | auto
MASAR_DATA_SOURCE=bigquery

# Docker resource limits
AIRFLOW_CPU_LIMIT=1.0
AIRFLOW_MEMORY_LIMIT=1536M
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=512M
STREAMLIT_CPU_LIMIT=0.75
STREAMLIT_MEMORY_LIMIT=1G